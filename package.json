{
	"name": "sekigae",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "学校の席替えアプリ（Cloudflare Workers の静的アセットで配信）",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"@material/material-color-utilities": "^0.4.0",
		"@material/web": "^2.5.0",
		"lit-html": "^3.3.3"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.161.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261110.1": true
	}
}
